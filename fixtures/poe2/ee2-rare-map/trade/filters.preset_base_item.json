{
  "api": "trade",
  "request": {
    "query": {
      "filters": {
        "map_filters": {
          "filters": {
            "map_tier": {
              "max": 14,
              "min": 14
            }
          }
        },
        "misc_filters": {
          "filters": {
            "fractured_item": {
              "option": "false"
            },
            "mirrored": {
              "option": "false"
            },
            "sanctified": {
              "option": "false"
            }
          }
        },
        "trade_filters": {
          "filters": {
            "collapse": {
              "option": "true"
            }
          }
        },
        "type_filters": {
          "filters": {
            "category": {
              "option": "map"
            },
            "rarity": {
              "option": "nonunique"
            }
          }
        }
      },
      "stats": [
        {
          "filters": [],
          "type": "and"
        }
      ],
      "status": {
        "option": "securable"
      }
    },
    "sort": {
      "price": "asc"
    }
  }
}
